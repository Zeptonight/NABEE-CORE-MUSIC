# ==== NABEE CORE configuration ====
# Copy to .env or set in your environment. Everything is optional at boot:
# the panel runs and shows honest NOT CONFIGURED states until you fill these in.

# --- web ---
PORT=8787
# Public URL used to build the GitHub OAuth redirect (required for login)
BASE_URL=
# Embed allowlist for sandbox preview only — set to 0 in production
ALLOW_IFRAME=1

# --- secrets ---
# Auto-generated & persisted to .data/secret.key if left empty
SESSION_SECRET=

# --- github oauth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Immutable numeric GitHub user id(s), comma separated (NOT usernames)
GITHUB_OWNER_ID=

# --- discord bot ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --- database ---
# Empty = SQLite at .data/nabee.db. Set for PostgreSQL:
# DATABASE_URL=postgres://nabee:nabee@localhost:5432/nabee

# --- audio ---
# FFMPEG_PATH=/usr/bin/ffmpeg

LOG_LEVEL=info
